{
  "name": "@marlinjai/brain-core",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0",
  "description": "Shared infrastructure for Brain services (auth, crypto, errors, types)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sdk": {
      "import": {
        "types": "./dist/sdk/index.d.ts",
        "default": "./dist/sdk/index.js"
      },
      "require": {
        "types": "./dist/sdk/index.d.cts",
        "default": "./dist/sdk/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "docs:dev": "clearify dev",
    "docs:build": "clearify build",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@marlinjai/clearify": "^2.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "hono": "^4.13.17",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "keywords": [
    "brain",
    "core",
    "auth",
    "crypto",
    "cloudflare",
    "workers",
    "shared"
  ],
  "author": "marlinjai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marlinjai/brain-core.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
